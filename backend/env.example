# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=senha

# GitHub OAuth App -> https://github.com/settings/developers
# "Authorization callback URL" tem que ser IGUAL ao GITHUB_REDIRECT_URI abaixo
GITHUB_CLIENT_ID=xxx
GITHUB_CLIENT_SECRET=xxx
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback

# Trello OAuth 2.0 -> https://trello.com/apps/admin
TRELLO_CLIENT_ID=xxx
TRELLO_CLIENT_SECRET=xxx
TRELLO_OAUTH_SCOPE=read:member:trello read:board:trello write:board:trello offline_access
# Fluxo legado; não é necessário para OAuth 2.0.
TRELLO_KEY=xxx
TRELLO_APP_NAME=COGNIS

# Sessão / segurança
# gerar com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=troque-isso
JWT_EXPIRES_MINUTES=10080
# gerar com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=troque-isso
COOKIE_SECURE=false

# Frontend (usado nos redirects pós-login e no CORS)
FRONTEND_URL=http://localhost:5173
